@startuml
!pragma layout smetana
title Inscription à un programme
left to right direction
skinparam shadowing false
skinparam dpi 180
skinparam classAttributeIconSize 0

class User {
  id: String
  name: String
  email: String
}
class Program {
  id: String
  title: String
}
class UserProgramEnrollment {
  currentWeek: Int
  status: String
  startDate: DateTime
}

User -[hidden]right- Program
User "1" -- "0..*" UserProgramEnrollment
Program "1" -- "0..*" UserProgramEnrollment
@enduml
