@startuml
!pragma layout smetana
title Modèles des commandes
left to right direction
skinparam shadowing false
skinparam dpi 180
skinparam classAttributeIconSize 0

class User {
  id: String
  email: String
}
class Product {
  id: String
  name: String
  price: Float
}
class Order {
  id: String
  orderNumber: String
  status: String
  total: Float
  createdAt: DateTime
}
class OrderItem {
  quantity: Int
  size: String
  color: String
}

User "1" -- "0..*" Order
Order "1" -- "0..*" OrderItem
Product "1" -- "0..*" OrderItem
@enduml
