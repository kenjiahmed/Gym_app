@startuml
!pragma layout smetana
title Structure des programmes
left to right direction
skinparam shadowing false
skinparam dpi 180
skinparam classAttributeIconSize 0

class Program {
  id: String
  title: String
  description: String
  level: String
  durationWeeks: Int
}
class ProgramWeek {
  weekNumber: Int
  title: String?
}
class ProgramWorkout {
  dayNumber: Int
  isRestDay: Boolean
}
class WorkoutPlan {
  id: String
  name: String
  workoutType: String?
  durationMinutes: Int?
}

Program "1" -- "0..*" ProgramWeek
ProgramWeek "1" -- "0..*" ProgramWorkout
WorkoutPlan "1" -- "0..*" ProgramWorkout
@enduml
