@startuml
!pragma layout smetana
title Modèles de l'entraînement et des séances
left to right direction
skinparam shadowing false
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam linetype ortho

class User {
  id: String
  name: String
  email: String
  role: String
  height: Float?
  weight: Float?
  fitnessGoal: String?
  subscriptionPlan: String
  subscriptionStatus: String
}
class Exercise {
  id: String
  name: String
  description: String?
  muscleGroup: String
  difficulty: String
}
class WorkoutPlan {
  id: String
  name: String
  workoutType: String?
  durationMinutes: Int?
}
class WorkoutExercise {
  sets: Int
  reps: Int
  restTime: Int
}
class WorkoutSession {
  id: String
  startTime: DateTime
  duration: Int?
  completed: Boolean
}
class CompletedSet {
  setNumber: Int
  reps: Int
  weight: Float?
}
class ScheduledWorkout {
  scheduledDate: DateTime
  completed: Boolean
}

User "1" -- "0..*" WorkoutPlan
WorkoutPlan "1" -- "0..*" WorkoutExercise
Exercise "1" -- "0..*" WorkoutExercise
User "1" -- "0..*" WorkoutSession
WorkoutPlan "1" -- "0..*" WorkoutSession
WorkoutSession "1" -- "0..*" CompletedSet
User "1" -- "0..*" ScheduledWorkout
@enduml
